# Must match the name you register on the Blackout site.
SNAKE_AUTHOR=the sea snake
SNAKE_COLOR=#4488ff

# Checkpoint trained for Blackout rules (restricted_standard, 15x15, 4 snakes).
BATTLE_SNAKE_CHECKPOINT=best_checkpoint/ppo_league_best.pt

# model_space = policy ranks; filter rejects suicide, losing head-to-heads and
#               pockets too small to hold us (default; +0.146 pts/game vs model)
# model       = as above without the space check
# veto        = adds a lookahead search; NOT fog-aware, measured worse
# tactics = JSON flood-fill/food/H2H search decides, policy breaks near-ties
# safe    = legacy space heuristic
MOVE_STRATEGY=model_space
SEARCH_BUDGET_MS=70

# cpu or cuda
TORCH_DEVICE=cpu
FALLBACK_MOVE=up
LOG_LEVEL=INFO

# Optional combat layer at inference (off by default; model already has survival shaping).
SURVIVAL_FILTER=0
SURVIVAL_HUNGER_HEALTH=35
SURVIVAL_STRATEGY=aggressive
